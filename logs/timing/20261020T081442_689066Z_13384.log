  \"C\u0103n c\u1ee9 ph\u00e1p l\u00fd\": \"Lu\u1eadt 60/2014/QH13 (Lu\u1eadt H\u1ed9 t\u1ecbch); Ngh\u1ecb quy\u1ebft s\u1ed1 66.7/2025/NQ-CP; Ngh\u1ecb \u0111\u1ecbnh s\u1ed1 123/2015/N\u0110-CP; Ngh\u1ecb \u0111\u1ecbnh s\u1ed1 87/2020/N\u0110-CP; Ngh\u1ecb \u0111\u1ecbnh s\u1ed1 104/2022/N\u0110-CP; Ngh\u1ecb \u0111\u1ecbnh s\u1ed1 07/2025/N\u0110-CP; Ngh\u1ecb \u0111\u1ecbnh s\u1ed1 120/2025/N\u0110-CP; Ngh\u1ecb \u0111\u1ecbnh s\u1ed1 18/2026/N\u0110-CP; Th\u00f4ng t\u01b0 s\u1ed1 85/2019/TT-BTC; Th\u00f4ng t\u01b0 s\u1ed1 04/2020/TT-BTP; Th\u00f4ng t\u01b0 s\u1ed1 106/2021/TT-BTC; Th\u00f4ng t\u01b0 s\u1ed1 01/2022/TT-BTP; Th\u00f4ng t\u01b0 s\u1ed1 03/2023/TT-BTP; Th\u00f4ng t\u01b0 s\u1ed1 04/2024/TT-BTP; Th\u00f4ng t\u01b0 s\u1ed1 08/2025/TT-BTP\"\n    },\n    {\n      \"T\u00ean th\u1ee7 t\u1ee5c h\u00e0nh ch\u00ednh\": \"Th\u1ee7 t\u1ee5c \u0111\u0103ng k\u00fd k\u1ebft h\u00f4n\",\n      \"L\u0129nh v\u1ef1c\": \"H\u1ed9 t\u1ecbch\",\n      \"H\u00ecnh th\u1ee9c n\u1ed9p\": \"C\u1ea3 hai\",\n      \"Th\u00e0nh ph\u1ea7n h\u1ed3 s\u01a1\": \"Ch\u1ee9ng minh nh\u00e2n d\u00e2n (ho\u1eb7c c\u0103n c\u01b0\u1edbc c\u00f4ng d\u00e2n, h\u1ed9 chi\u1ebfu) c\u1ee7a b\u00ean nam v\u00e0 b\u00ean n\u1eef 01 b\u1ea3n photo (Xu\u1ea5t tr\u00ecnh b\u1ea3n ch\u00ednh).\\n Tr\u01b0\u1eddng h\u1ee3p b\u00ean nam ho\u1eb7c b\u00ean n\u1eef th\u01b0\u1eddng tr\u00fa t\u1ea1i \u0111\u1ecba ph\u01b0\u01a1ng (n\u1ebfu \u0111\u00e3 ly h\u00f4n th\u00ec k\u00e8m b\u1ea3n photo c\u1ee7a quy\u1ebft \u0111\u1ecbnh ly h\u00f4n, n\u1ebfu c\u00f3 ch\u1ed3ng/v\u1ee3 \u0111\u00e3 ch\u1ebft th\u00ec cung c\u1ea5p \u0111\u0103ng k\u00fd khai t\u1eed c\u1ee7a ch\u1ed3ng/v\u1ee3) kh\u00f4ng c\u1ea7n x\u00e1c nh\u1eadn t\u00ecnh tr\u1ea1ng h\u00f4n nh\u00e2n \u0111\u1ec3 \u0111\u0103ng k\u00fd k\u1ebft h\u00f4n.\\n Gi\u1ea5y t\u1edd ch\u1ee9ng minh th\u00f4ng tin c\u01b0 tr\u00fa: th\u00f4ng b\u00e1o \u0111\u0103ng k\u00fd t\u1ea1m tr\u00fa (do c\u00f4ng an ph\u01b0\u1eddng c\u1ea5p).\",\n      \"Th\u1eddi gian gi\u1ea3i quy\u1ebft\": \"Trong ng\u00e0y l\u00e0m vi\u1ec7c (n\u1ebfu nh\u1eadn h\u1ed3 s\u01a1 sau 15 gi\u1edd th\u00ec tr\u1ea3 k\u1ebft qu\u1ea3 v\u00e0o ng\u00e0y h\u00f4m sau).\",\n      \"L\u1ec7 ph\u00ed\": \"B\u1ea3n ch\u00ednh: Kh\u00f4ng thu ph\u00ed B\u1ea3n sao: 8.000\u0111/b\u1ea3n\",\n      \"\u0110\u1ecba \u0111i\u1ec3m ti\u1ebfp nh\u1eadn h\u1ed3 s\u01a1 tr\u1ef1c ti\u1ebfp (n\u1ebfu c\u00f3)\": \"Trung t\u00e2m Ph\u1ee5c v\u1ee5 h\u00e0nh ch\u00ednh c\u00f4ng ph\u01b0\u1eddng T\u0103ng Nh\u01a1n Ph\u00fa\",\n      \"Ghi ch\u00fa\": \"\",\n      \"Trong tr\u01b0\u1eddng h\u1ee3p h\u1ed3 s\u01a1 bao g\u1ed3m c\u00e1c bi\u1ec3u m\u1eabu vui l\u00f2ng d\u00ednh k\u00e8m file m\u1eabu\": \"\",\n      \"tr\u1ea1ng th\u00e1i\": \"Xong\",\n      \"C\u0103n c\u1ee9 ph\u00e1p l\u00fd\": \"Lu\u1eadt 60/2014/QH13 (Lu\u1eadt H\u1ed9 t\u1ecbch); Lu\u1eadt 52/2014/QH13 (Lu\u1eadt H\u00f4n nh\u00e2n v\u00e0 gia \u0111\u00ecnh); Ngh\u1ecb quy\u1ebft s\u1ed1 66.7/2025/NQ-CP; Ngh\u1ecb \u0111\u1ecbnh s\u1ed1 123/2015/N\u0110-CP; Ngh\u1ecb \u0111\u1ecbnh s\u1ed1 87/2020/N\u0110-CP; Ngh\u1ecb \u0111\u1ecbnh s\u1ed1 104/2022/N\u0110-CP; Ngh\u1ecb \u0111\u1ecbnh s\u1ed1 07/2025/N\u0110-CP; Ngh\u1ecb \u0111\u1ecbnh s\u1ed1 120/2025/N\u0110-CP; Ngh\u1ecb \u0111\u1ecbnh s\u1ed1 18/2026/N\u0110-CP; Th\u00f4ng t\u01b0 s\u1ed1 85/2019/TT-BTC; Th\u00f4ng t\u01b0 s\u1ed1 04/2020/TT-BTP; Th\u00f4ng t\u01b0 s\u1ed1 106/2021/TT-BTC; Th\u00f4ng t\u01b0 s\u1ed1 01/2022/TT-BTP; Th\u00f4ng t\u01b0 s\u1ed1 03/2023/TT-BTP; Th\u00f4ng t\u01b0 s\u1ed1 04/2024/TT-BTP; Th\u00f4ng t\u01b0 s\u1ed1 08/2025/TT-BTP\"\n    }\n  ]\n}\n\nC\u00c2U H\u1eceI C\u1ee6A NG\u01af\u1edcI D\u00d9NG:\nL\u1ec7 ph\u00ed \u0111\u0103ng k\u00fd khai sinh v\u00e0 \u0111\u0103ng k\u00fd k\u1ebft h\u00f4n l\u1ea7n l\u01b0\u1ee3t l\u00e0 bao nhi\u00eau?\n\nTR\u1ea2 L\u1edcI:"}], "stream": true, "max_tokens": 800, "temperature": 0.1, "top_p": 0.95}}
